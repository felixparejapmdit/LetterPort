# LetterPort LMS Environment Configuration

# Server Ports
PORT=8766
FRONTEND_PORT=8765

# Database Configuration
# Options: sqlite | pocketbase | postgres
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/letterport.db

# For PocketBase mode:
# DATABASE_TYPE=pocketbase
# POCKETBASE_URL=http://localhost:8090

# For PostgreSQL in Docker:
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:postgres_secret@db:5432/letterport_db

# File Storage
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Queue & Background Workers
# Options: local | redis
QUEUE_TYPE=local
REDIS_HOST=localhost
REDIS_PORT=6379

# OCR Configuration
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng

# API URL for Frontend
# (Defaults to /api to use Next.js proxy rewrite to backend, or set http://localhost:8766/api)
NEXT_PUBLIC_API_URL=/api
