# LetterPort LMS Environment Configuration

# Server Ports
PORT=5001
FRONTEND_PORT=3001

# Database Configuration
# Options: pocketbase | sqlite | postgres
DATABASE_TYPE=pocketbase
# PocketBase URL (default local instance)
POCKETBASE_URL=http://localhost:8090

# For SQLite zero-setup mode:
# DATABASE_TYPE=sqlite
# DATABASE_FILE=./data/letterport.db

# For PostgreSQL in Docker:
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:postgres_secret@db:5432/letterport_db

# File Storage
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Queue & Background Workers
# Options: local | redis
QUEUE_TYPE=local
REDIS_HOST=localhost
REDIS_PORT=6379

# OCR Configuration
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng

# API URL for Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001/api
